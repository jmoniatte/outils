# ~/.config/outils/config.yaml (optional)

# Color theme: terminal (read from the terminal itself) or any base16 scheme
# in tui-kit (tui_kit/styles/themes/), by its upstream slug. Press t in the app to
# browse them; the choice is written back here.
theme: terminal

# First day of the week in the calendar: monday (the default) to sunday.
week_start: monday

# The clocks on the Time tab, top to bottom: the name shown, then its IANA time zone
# (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
clocks:
  Portland: America/Los_Angeles
  Chicago: America/Chicago
  UTC: UTC
  Strasbourg: Europe/Paris

# Your cities (Portland, OR by default): the weather and the calendar open on the first, and the
# City boxes suggest the others as you type. "City", or "City, Region or Country" when the name is
# shared (Portland, ME; Paris, France). Each is looked up once through Open-Meteo, then cached.
locations:
  - Portland, OR
  - Strasbourg, FR

# metric (°C, km/h, mm; the default) or imperial (°F, mph, in). °C and °F on the Weather tab
# switch it and save the choice here.
units: metric

# Birthdays, shown on the calendar every year with a cake: MM-DD, or YYYY-MM-DD with the year
# born to show the age ("Léa (36)").
birthdays:
  10-02: Mom
  1990-11-05: Léa
