# ~/.config/outils/config.yaml (optional)

# Color theme: terminal (read from the terminal itself) or any base16 scheme
# in ouikit (ouikit/styles/themes/), by its upstream slug. Press t in the app to
# browse them; the choice is written back here.
theme: terminal


# First day of the week in the calendar: monday (the default) to sunday.
week_start: monday

# Where the weather opens (Portland, OR by default): "City", or "City, Region or Country" when
# the name is shared (Portland, ME; Paris, France). Looked up once through Open-Meteo, then cached.
location: Portland, OR

# metric (°C, km/h, mm; the default) or imperial (°F, mph, in)
units: metric
