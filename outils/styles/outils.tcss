/* ═══════════════════════════════════════════════════════════════════════
   FOOTER - the same under every tab: a rule like the header's, then Close
   ═══════════════════════════════════════════════════════════════════════ */

#app-footer {
    dock: bottom;
    height: auto;
}

/* Where the tab's data comes from, over the rule; only tabs with a CREDIT show it */
#mode-credit {
    height: 1;
    padding: 0 1;
}

#mode-credit .spacer {
    width: 1fr;
}

#mode-credit-text {
    width: auto;
    color: $comment;
}

/* The calendar's date: something to read, not a source */
#mode-credit-text.-footnote {
    color: $blue;
}

/* Like every link, the repository's on Help included: blue, underlined on hover */
#mode-credit-link {
    width: auto;
    color: $blue;
    /* Textual's Link is underlined by default */
    text-style: none;
    background: transparent;
}

#mode-credit-link:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

#app-footer-bar {
    height: auto;
    padding: 0 1;
    border-top: solid $gutter;
}

/* Neutral, like the Close button on ouikit's panels */
#btn-close {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

#btn-close:hover {
    background: $gutter;
}

/* ═══════════════════════════════════════════════════════════════════════
   CALENDAR - this month and the next, side by side like cal
   ═══════════════════════════════════════════════════════════════════════ */

/* No room on top: the tabs keep a blank row under them. Left, like the other tabs */
#calendar {
    height: auto;
    padding: 0 4 1 4;
}

#calendar-body {
    width: auto;
    height: auto;
}

/* As wide as the months below: Previous over the left edge, Today in the middle, Next on the right */
#calendar-nav {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#calendar-nav .spacer {
    width: 1fr;
}

#calendar-nav Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

#calendar-nav Button:hover {
    background: $gutter;
}

/* The same width either side, so Today lands in the middle; green, where Today is blue */
#calendar-nav #btn-previous,
#calendar-nav #btn-next {
    /* Room to spare around "← Previous": with none, Textual wraps it and only the arrow shows */
    width: 14;
    padding: 0 1;
    background: $green 30%;
    color: $green;
}

#calendar-nav #btn-previous:hover,
#calendar-nav #btn-next:hover {
    background: $green 50%;
}

#calendar-nav #btn-today {
    background: $blue 30%;
    color: $blue;
}

#calendar-nav #btn-today:hover {
    background: $blue 50%;
}

#calendar-months {
    width: auto;
    height: auto;
}

/* Four columns between months: this margin plus the space each day cell keeps on its sides */
MonthView {
    margin-left: 2;
    color: $fg;
}

MonthView:first-of-type {
    margin-left: 0;
}

MonthView > .month--title {
    color: $fg;
}

/* Today's month, wherever it is in the row */
MonthView > .month--title-current {
    color: $blue;
    text-style: bold;
}

/* A month wholly before today's, faded like its days */
MonthView > .month--title-past {
    color: $comment;
}

MonthView > .month--weekdays {
    color: $fg;
}

/* Saturday and Sunday, marked in the day names only: grey numbers mean past */
MonthView > .month--weekend {
    color: $comment;
}

MonthView > .month--rule {
    color: $gutter;
}

/* Days before today */
MonthView > .month--past {
    color: $comment;
}

MonthView > .month--today {
    background: $blue;
    color: $bg;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   TIME - the epoch converter, a rule, then the time now in a few places
   ═══════════════════════════════════════════════════════════════════════ */

#time {
    height: auto;
    padding: 0 4 1 4;
}

#clocks {
    width: auto;
    height: auto;
    color: $fg;
}

#clocks > .clocks--time {
    text-style: bold;
}

/* Orange, like the weather's high temperatures */
#clocks > .clocks--offset {
    color: $orange;
}

#clocks > .clocks--dst {
    color: $yellow;
}


/* As wide as the results' labels, so the box lines up with the values under it */
#epoch-row .lookup-label {
    width: 10;
}

/* Room for a timestamp in milliseconds or a date like 2026-09-24 15:30; longer text scrolls */
#epoch-input {
    width: 20;
}

/* Back to following now; green like the calendar's Previous and Next */
#btn-now {
    width: auto;
    min-width: 0;
    height: 1;
    margin-left: 2;
    border: none;
    padding: 0 2;
    background: $green 30%;
    color: $green;
}

#btn-now:hover {
    background: $green 50%;
}

#epoch-details {
    height: auto;
    color: $fg;
}

/* Between the epoch and the clocks, a rule like the footer's */
#time-rule {
    margin: 1 0;
    color: $gutter;
}

/* Green like the IP tab's labels */
#epoch-details > .epoch--label {
    color: $green;
}

#epoch-details > .epoch--error {
    color: $red;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOOKUP BOX - what the weather and the IP tabs look up, over what was found
   ═══════════════════════════════════════════════════════════════════════ */

.lookup-row {
    height: 2;
    margin-bottom: 1;
}

/* Green like the labels of the IP tab */
.lookup-label {
    width: 6;
    color: $green;
}

/* Underlined like ouikit's theme filter, so it reads as a place to type */
LookupBox {
    width: 40;
    height: 2;
    padding: 0;
    background: transparent;
    color: $fg;
    border: none !important;
    border-bottom: solid $gutter !important;
}

LookupBox:focus {
    border-bottom: solid $blue !important;
}

/* What was found, in full, until the box is clicked again */
LookupBox.-found {
    color: $blue;
}

/* ═══════════════════════════════════════════════════════════════════════
   WEATHER - the place, the weather now, then a row per day
   ═══════════════════════════════════════════════════════════════════════ */

#weather {
    height: auto;
    padding: 0 4 1 4;
}

/* °C and °F on the city's row: the one in use in blue, the other grey until hovered */
#weather-units {
    width: auto;
    height: 1;
    margin-left: 2;
}

#weather-units Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0;
    margin-left: 1;
    background: transparent;
    color: $comment;
}

#weather-units Button:hover {
    color: $fg;
}

#weather-units Button.-selected {
    color: $blue;
    text-style: bold;
}

#forecast {
    height: auto;
    color: $fg;
}

#forecast > .weather--temperature {
    text-style: bold;
}

#forecast > .weather--dim {
    color: $comment;
}

#forecast > .weather--high {
    color: $orange;
}

#forecast > .weather--low {
    color: $cyan;
}

#forecast > .weather--rain {
    color: $blue;
}

#forecast > .weather--message {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   IP - an address, this computer's by default, then what ipinfo.io knows about it
   ═══════════════════════════════════════════════════════════════════════ */

#ip {
    height: auto;
    padding: 0 4 1 4;
}

/* As wide as the details' labels ("Postal code" and two spaces), so the box lines up with the values */
#ip .lookup-label {
    width: 13;
}

#ip-details {
    height: auto;
    color: $fg;
}

/* Green like the keys on the Help panel: grey was too faint to read */
#ip-details > .ip--label {
    color: $green;
}

#ip-details > .ip--address {
    color: $blue;
    text-style: bold;
}

#ip-details > .ip--message {
    color: $comment;
}

#ip-details > .ip--error {
    color: $red;
}

/* ═══════════════════════════════════════════════════════════════════════
   DROPBOX - Start or Stop, then the files that changed last
   ═══════════════════════════════════════════════════════════════════════ */

#dropbox {
    height: 1fr;
    padding: 0 4 1 4;
}

/* Over the list, lined up with its right edge */
#dropbox-row {
    height: 1;
    margin-bottom: 1;
    align-horizontal: right;
}

#dropbox-state {
    width: auto;
}

#dropbox-state.-starting {
    color: $green;
}

#dropbox-state.-stopping,
#dropbox-state.-missing {
    color: $red;
}

/* Red to stop, green to start, like "Stopping..." and "Starting..." */
#btn-dropbox-toggle {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    background: $red 30%;
    color: $red;
}

#btn-dropbox-toggle:hover {
    background: $red 50%;
}

#btn-dropbox-toggle.-start {
    background: $green 30%;
    color: $green;
}

#btn-dropbox-toggle.-start:hover {
    background: $green 50%;
}

/* A thin scrollbar, only when the files do not all fit */
#dropbox-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $comment;
}

/* A row per file; the scroll above holds it */
#dropbox-files {
    height: auto;
    color: $fg;
}

#dropbox-files > .dropbox--age {
    color: $green;
}

/* Dimmer than the file name, so it stands out, but easy to read */
#dropbox-files > .dropbox--folder {
    color: $fg 60%;
}

/* What the row is about */
#dropbox-files > .dropbox--name {
    text-style: bold;
}

/* Like flotte's tables: the selected row, under the mouse or the arrows, keeps its colors */
#dropbox-files > .dropbox--cursor {
    background: $bg-light;
}

#dropbox-files > .dropbox--message {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   SOUND - the outputs, a line, then the microphones, a device per row
   ═══════════════════════════════════════════════════════════════════════ */

#sound {
    height: 1fr;
    padding: 0 4 1 4;
}

#sound-sections {
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $comment;
}

.section-cards {
    height: auto;
}

/* The microphones sit under a line, the same as the header's, rather than a title, a blank row under it */
#inputs-cards {
    border-top: solid $gutter;
    padding-top: 1;
}

/* ─── one device ─────────────────────────────────────────────────────── */

/* One line per device and a blank line between them; the one the keys act on is highlighted */
DeviceCard {
    height: 1;
    margin-bottom: 1;
}

/* The output and the microphone in use are always highlighted, and so is the row under the
   mouse or the keys. The highlight covers the name, the figure and the bar, not the buttons,
   whose own colors would change over it; so the gaps inside that stretch are padding, which
   takes the background, not margin */
DeviceCard:focus .card-label,
DeviceCard:focus .card-volume,
DeviceCard:focus .card-bar,
DeviceCard:focus .card-state,
DeviceCard.-default .card-label,
DeviceCard.-default .card-volume,
DeviceCard.-default .card-bar,
DeviceCard.-default .card-state {
    background: $bg-light;
}

/* Takes what the fixed columns on the right leave, up to a limit, so the bars still line up,
   a narrow window shortens names rather than squashing the buttons, and a wide one does not
   push the volume far from the name */
DeviceCard .card-label {
    width: 1fr;
    max-width: 36;
    padding: 0 1;
}

DeviceCard .card-name {
    width: auto;
    max-width: 100%;
    color: $fg;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The only color a name takes: green for the device in use. Muted or not connected shows
   in the buttons, so every other name stays plain */
DeviceCard.-default .card-name {
    color: $green;
    text-style: bold;
}

/* $fg like the percentage: $comment all but vanishes on the highlight */
DeviceCard .card-battery {
    width: auto;
    margin-left: 2;
    color: $fg;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

DeviceCard .card-volume {
    width: 7;
    padding-right: 2;
    text-align: right;
    color: $fg;
}

DeviceCard.-muted .card-volume {
    color: $comment;
}

DeviceCard .card-bar {
    width: 15;
    padding-right: 1;
}

DeviceCard .card-bar > .volume-bar--lit {
    color: $blue;
}

DeviceCard .card-bar > .volume-bar--unlit {
    color: $gutter;
}

DeviceCard.-muted .card-bar > .volume-bar--lit {
    color: $comment;
}

DeviceCard .card-state {
    width: 22;
    color: $comment;
}

DeviceCard Button {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 0 0 1;
    border: none;
    padding: 0 1;
    background: $blue 30%;
    color: $blue;
}

DeviceCard Button:hover {
    background: $blue 50%;
}

DeviceCard Button:disabled {
    background: $bg-light;
    color: $comment;
}

/* As wide as "Unmute", so the Bluetooth buttons line up */
DeviceCard .btn-mute {
    width: 10;
    background: $red 30%;
    color: $red;
}

DeviceCard .btn-mute:hover {
    background: $red 50%;
}

DeviceCard .btn-mute.-unmute {
    background: $green 30%;
    color: $green;
}

DeviceCard .btn-mute.-unmute:hover {
    background: $green 50%;
}

/* ═══════════════════════════════════════════════════════════════════════
   LIFE - Conway's Game of Life, filling the tab
   ═══════════════════════════════════════════════════════════════════════ */

#life {
    height: 1fr;
    margin: 0 4 1 4;
}

#life > .life--cell {
    color: $green;
}

/* ═══════════════════════════════════════════════════════════════════════
   SNAKE - a walled board, the score right of it
   ═══════════════════════════════════════════════════════════════════════ */

#snake {
    height: 1fr;
    padding: 0 4 1 4;
}

#snake-board {
    height: 1fr;
}

/* From the first row inside the wall to the last: the state on top, the scores at the bottom */
#snake-side {
    width: auto;
    height: 1fr;
    margin: 1 0 1 3;
}

#snake-side Static {
    width: auto;
}

#snake-side .spacer {
    height: 1fr;
}

/* The state first, in its color; nothing while a game runs */
#snake-state {
    text-style: bold;
}

#snake-state.-ready {
    color: $blue;
}

#snake-state.-won {
    color: $green;
}

#snake-state.-paused {
    color: $yellow;
}

#snake-state.-over {
    color: $red;
}

/* How close the score is to the best: red, orange, yellow, then blue once it is a record */
#snake-score {
    text-style: bold;
}

#snake-score.-low {
    color: $red;
}

#snake-score.-half {
    color: $orange;
}

#snake-score.-close {
    color: $yellow;
}

#snake-score.-record {
    color: $blue;
}

#snake-best {
    color: $comment;
}

#snake-new-best {
    color: $yellow;
}

#snake-prompt {
    margin-top: 1;
    color: $comment;
}

/* The wall, in half blocks hugging the board */
#snake-board > .snake--wall {
    color: $comment;
}

#snake-board > .snake--crash {
    color: $red;
}

#snake-board > .snake--body {
    color: $green;
}

#snake-board > .snake--head {
    color: $yellow;
}

#snake-board > .snake--food {
    color: $red;
}

/* The splash screen's title, yellow like the head */
#snake-board > .snake--title {
    color: $yellow;
    text-style: bold;
}

